# Copy to .env (git-ignored). Without QLOO_API_KEY the app runs on labelled MOCK data.
QLOO_API_KEY=
# Hackathon keys ONLY work on this host (401 anywhere else):
QLOO_BASE_URL=https://hackathon.api.qloo.com
PORT=3000

# Optional: any OpenAI-compatible endpoint rewrites the plan copy (Qloo still supplies every pick).
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
